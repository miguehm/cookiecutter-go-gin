package services

import (
	"{{ go_module }}/internal/core/models"
	"{{ go_module }}/internal/core/repositories"
)

// {{ model }}Service implements the {{ model }} use cases on top of its repository.
type {{ model }}Service struct {
	{{ model_camelcase }}Repository repositories.I{{ model }}Repository
}

// New{{ model }}Service returns a {{ model }}Service backed by repo.
func New{{ model }}Service(repo repositories.I{{ model }}Repository) *{{ model }}Service {
	return &{{ model }}Service{
		{{ model_camelcase }}Repository: repo,
	}
}

// GetAll returns all {{ model }} records.
func (s *{{ model }}Service) GetAll() ([]*models.{{ model }}, error) {
