# Example configuration for {{ cookiecutter.project_name }}.
# Copy it to env/<stage>.env and replace the placeholders. Never commit real
# secrets: use your secret manager or CI variables in production.

# General
# ==========================================================
STAGE=dev
PORT=8080
GIN_MODE=debug
ENABLE_PPROF=false

# Security
# ==========================================================
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER={{ cookiecutter.project_slug }}
JWT_AUDIENCE={{ cookiecutter.project_slug }}
JWT_EXPIRATION=24h
JWT_LEEWAY=30s
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
ENABLE_LOG_REQUEST_DETAIL=false
ENABLE_SWAGGER=false
ENABLE_ASYNQMON=false
ENABLE_HSTS=false
SENTRY_DSN=

# CORS
# ==========================================================
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
TRUSTED_PROXIES=

# Limits
# ==========================================================
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
WORKER_CONCURRENCY=10

# Database
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME={{ cookiecutter.project_slug }}
DB_SSL_MODE=disable
DB_LOG_LEVEL=1

# Redis
# ==========================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0
REDIS_TASK_DB=1
REDIS_ENABLE_SSL=false
