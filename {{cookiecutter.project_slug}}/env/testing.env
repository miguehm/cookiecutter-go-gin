# General
# ==========================================================
STAGE=testing
PORT=8080
GIN_MODE=test
ENABLE_PPROF=false

# Security
# ==========================================================
JWT_SECRET=testing-secret-change-me-0123456789abcdef
JWT_ISSUER=go-gin-template
JWT_AUDIENCE=go-gin-template
JWT_EXPIRATION=24h
JWT_LEEWAY=30s
BASIC_AUTH_USER=asynqmon
BASIC_AUTH_PASS=change-me-in-testing
ENABLE_LOG_REQUEST_DETAIL=false
ENABLE_SWAGGER=false
ENABLE_ASYNQMON=false
ENABLE_HSTS=false
SENTRY_DSN=

# CORS
# ==========================================================
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_PROXIES=

# Limits
# ==========================================================
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# Database
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dev
DB_PASS=dev
DB_NAME={{ cookiecutter.project_slug }}_test
DB_SSL_MODE=disable
DB_LOG_LEVEL=1

# Redis
# ==========================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=dev
REDIS_DB=0
REDIS_TASK_DB=1
REDIS_ENABLE_SSL=false
