# General
# ==========================================================
STAGE=testing
PORT=8080
GIN_MODE=test
ENABLE_PPROF=false

# Security
# ==========================================================
JWT_SECRET=testing-secret-change-me
BASIC_AUTH_USER=dev
BASIC_AUTH_PASS=dev
ENABLE_LOG_REQUEST_DETAIL=false
SENTRY_DSN=

# Database
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dev
DB_PASS=dev
DB_NAME={{ cookiecutter.project_slug }}_test
DB_SSL_MODE=disable
DB_LOG_LEVEL=1

# Redis
# ==========================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=dev
REDIS_DB=0
REDIS_TASK_DB=1
REDIS_ENABLE_SSL=false
