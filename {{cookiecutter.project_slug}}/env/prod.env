# General
# ==========================================================
STAGE=prod
PORT=8080
GIN_MODE=release
ENABLE_PPROF=false

# Security
# ==========================================================
JWT_SECRET=
JWT_ISSUER=go-gin-template
JWT_AUDIENCE=go-gin-template
JWT_EXPIRATION=15m
JWT_LEEWAY=30s
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
ENABLE_LOG_REQUEST_DETAIL=false
ENABLE_SWAGGER=false
ENABLE_ASYNQMON=false
ENABLE_HSTS=true
SENTRY_DSN=

# CORS
# ==========================================================
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=

# Limits
# ==========================================================
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
WORKER_CONCURRENCY=10

# Database
# ==========================================================
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL_MODE=require
DB_LOG_LEVEL=1

# Redis
# ==========================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0
REDIS_TASK_DB=1
REDIS_ENABLE_SSL=true
