COOKIECUTTER_VERSION ?= 2.7.1
GOLANGCI_LINT_VERSION ?= v2.15.0
GOVULNCHECK_VERSION ?= v1.9.0
GOSEC_VERSION ?= v2.30.0
GITLEAKS_VERSION ?= v8.28.0
TRIVY_VERSION ?= v0.76.1

# Fixtures generated by the harness; empty means all eight of the repository.
FIXTURES ?=

.PHONY: help test-template lint-py security cookiecutter-version

help:
	@echo "Targets:"
	@echo "  test-template  Generates the fixtures and validates the resulting projects"
	@echo "                 FIXTURES=minimal,full narrows down the matrix"
	@echo "  lint-py        Runs Ruff over the test harness"
	@echo "  security       Scans the template with gitleaks and trivy (when available)"
	@echo "                 gosec and govulncheck run inside test-template"
	@echo "  cookiecutter-version  Prints the pinned Cookiecutter version"
	@echo ""
	@echo "Cookiecutter:    $(COOKIECUTTER_VERSION)"
	@echo "golangci-lint:   $(GOLANGCI_LINT_VERSION)"
	@echo "govulncheck:     $(GOVULNCHECK_VERSION)"
	@echo "gosec:           $(GOSEC_VERSION)"
	@echo "gitleaks:        $(GITLEAKS_VERSION)"
	@echo "trivy:           $(TRIVY_VERSION)"
	@echo "Fixtures:        $(if $(FIXTURES),$(FIXTURES),todos)"

cookiecutter-version:
	@echo "$(COOKIECUTTER_VERSION)"

test-template: lint-py
	FIXTURES="$(FIXTURES)" \
	COOKIECUTTER_VERSION=$(COOKIECUTTER_VERSION) \
	uvx --with pytest --with pyyaml --with pexpect pytest -q tests/

# NixOS note: `uvx ruff` may not start; the target falls back to nix-shell there.
lint-py:
	@if command -v ruff >/dev/null 2>&1; then \
		ruff check .; \
	elif [ "$$(. /etc/os-release 2>/dev/null; echo $${ID:-})" = nixos ]; then \
		nix-shell -p ruff --run "ruff check ."; \
	else \
		uvx ruff check .; \
	fi

security:
	@if command -v gitleaks >/dev/null 2>&1; then \
		gitleaks detect --source . --no-git --config .gitleaks.toml; \
	else \
		echo "gitleaks no disponible"; \
	fi
	@if command -v trivy >/dev/null 2>&1; then \
		trivy fs --scanners secret --exit-code 1 --skip-dirs .opencode . && \
		trivy fs --scanners vuln --exit-code 0 --skip-dirs .opencode .; \
	else \
		echo "trivy no disponible"; \
	fi
